# Copy this file to .env.local and replace the placeholders with values from
# Supabase Dashboard > Project Settings > API.
#
# Never commit .env.local or real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: natural-sounding voice for the per-step listen button. Add it in
# Vercel > Project Settings > Environment Variables. Without it, the browser's
# built-in voice is used. Server-side only; never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
